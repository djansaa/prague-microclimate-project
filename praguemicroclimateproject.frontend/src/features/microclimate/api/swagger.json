          "sensor_position_detail": {
            "type": "string",
            "description": "SensorPositionDetail [example: \"veřejné osvětlení ve středu Tržnice\"]",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Microclimate point response model."
      },
      "Point3Measure": {
        "type": "object",
        "properties": {
          "measure": {
            "type": "string",
            "description": "Measure [example: \"air_temp200\"]",
            "nullable": true
          },
          "measure_cz": {
            "type": "string",
            "description": "MeasureCz [example: \"Teplota vzduchu, 200 cm\"]",
            "nullable": true
          },
          "unit": {
            "type": "string",
            "description": "Unit [example: \"°C\"]",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Microclimate point measure response model."
      }
    }
