{
  "openapi": "3.0.4",
  "info": {
    "title": "PragueMicroclimateProject",
    "version": "1.0"
  },
  "paths": {
    "/api/Microclimate/locationsAndPoints": {
      "get": {
        "tags": [
          "Microclimate"
        ],
        "summary": "Get ALL microclimate locations and points.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Location"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Location"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Location"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Microclimate/pointMeasurements": {
      "get": {
        "tags": [
          "Microclimate"
        ],
        "summary": "Get point measurements.",
        "parameters": [
          {
            "name": "locationId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pointId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "measure",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Microclimate/pointMeasurementsParallel": {
      "get": {
        "tags": [
          "Microclimate"
        ],
        "summary": "Get point measurements.",
        "parameters": [
          {
            "name": "locationId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pointId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "measure",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Location": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier of the location.",
            "format": "int32",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "Display name of the location.",
            "nullable": true
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the location.",
            "nullable": true
          },
          "surface": {
            "type": "string",
            "description": "Surface type associated with the location.",
            "nullable": true
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "description": "Measurement points belonging to the location.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Represents a microclimate location in Prague."
      },
      "Measurement": {
        "type": "object",
        "properties": {
          "locationId": {
            "type": "integer",
            "description": "Identifier of the location the measurement belongs to.",
            "format": "int32",
            "nullable": true
          },
          "pointId": {
            "type": "integer",
            "description": "Identifier of the point the measurement belongs to.",
            "format": "int32",
            "nullable": true
          },
          "type": {
            "type": "string",
            "description": "Internal measurement type code.",
            "nullable": true
          },
          "unit": {
            "type": "string",
            "description": "Unit of the measured value.",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "description": "Date and time when the value was measured.",
            "format": "date-time",
            "nullable": true
          },
          "value": {
            "type": "number",
            "description": "Numeric value of the measurement.",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Represents a normalized microclimate measurement."
      },
      "Point": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier of the point.",
            "format": "int32",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "Display name of the point.",
            "nullable": true
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the point.",
            "nullable": true
          },
          "sensorPosition": {
            "type": "string",
            "description": "Physical placement or sensor position of the point.",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "description": "Latitude of the point.",
            "format": "double",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "description": "Longitude of the point.",
            "format": "double",
            "nullable": true
          },
          "measurementTypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Measurement types available for the point.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Represents a measurement point within a microclimate location."
      }
    }
  },
  "tags": [
    {
      "name": "Microclimate"
    }
  ]
}