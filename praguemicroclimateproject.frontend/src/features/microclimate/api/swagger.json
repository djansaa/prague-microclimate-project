            "format": "double",
            "nullable": true
          },
          "lng": {
            "type": "number",
            "description": "Lng",
            "format": "double",
            "nullable": true
          },
          "x_jtsk": {
            "type": "number",
            "description": "XJtsk",
            "format": "double",
            "nullable": true
          },
          "y_jtsk": {
            "type": "number",
            "description": "YJtsk",
            "format": "double",
            "nullable": true
          },
          "elevation_m": {
            "type": "number",
            "description": "ElevationM",
            "format": "double",
            "nullable": true
          },
