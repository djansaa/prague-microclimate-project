            "format": "int32"
          },
          "location": {
            "type": "string",
            "description": "LocationName [example: \"Pražská Holešovická tržnice\"]",
            "nullable": true
          },
          "loc_description": {
            "type": "string",
            "description": "LocDescription [example: \"areál bez zeleně\"]",
            "nullable": true
          },
          "loc_orientation": {
            "type": "string",
            "description": "LocOrientation [example: \"východ-západ\"]",
            "nullable": true
          },
          "loc_surface": {
            "type": "string",
            "description": "LocSurface [example: \"asfalt/beton\"]",
            "nullable": true
          },
          "address": {
            "type": "string",
            "description": "Address [example: \"Pražská tržnice\"]",
            "nullable": true
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationPoint"
            },
            "description": "Points",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Microclimate location response model."
      },
      "LocationPoint": {
        "type": "object",
        "properties": {
          "point_id": {
            "type": "integer",
            "description": "PointId",
            "format": "int32"
          },
          "point_name": {
            "type": "string",
            "description": "PointName [example: \"Pražská tržnice osvětlení\"]",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Microclimate location point response model."
      },
      "Measurement": {
        "type": "object",
        "properties": {
          "point_id": {
            "type": "number",
            "description": "PointId",
            "format": "double",
            "nullable": true
          },
          "location_id": {
            "type": "number",
            "description": "LocationId",
            "format": "double",
            "nullable": true
          },
          "measured_at": {
            "type": "string",
            "description": "MeasuredAt [example: \"2022-08-21T17:30:00.000Z\"]",
            "format": "date-time",
            "nullable": true
          },
          "measure": {
            "type": "string",
            "description": "Measure [example: \"air_temp200\"]",
            "nullable": true
          },
          "value": {
            "type": "number",
            "description": "Value",
            "format": "double",
            "nullable": true
          },
          "unit": {
            "type": "string",
            "description": "Unit [example: \"°C\"]",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Microclimate measurement response model."
      },
      "Point3": {
        "type": "object",
        "properties": {
          "point_id": {
            "type": "integer",
            "description": "PointId",
            "format": "int32"
          },
          "location_id": {
            "type": "integer",
            "description": "LocationId",
            "format": "int32"
